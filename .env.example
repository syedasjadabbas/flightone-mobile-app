# FlightOne Express API (same server the web app uses).
# Phone on the same Wi-Fi: use your PC's LAN IP, e.g. http://192.168.1.20:8084/api/v1
# Android emulator: http://10.0.2.2:8084/api/v1
# iOS simulator / web: http://localhost:8084/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8084/api/v1

# Never put INTERNAL_API_KEY or any other secret here:
# every EXPO_PUBLIC_* value is bundled into the app.
